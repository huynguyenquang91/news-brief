# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Target Google Sheet ID (the long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit)
GOOGLE_SHEET_ID=your-sheet-id

# Service-account credentials.
# Local: point to the downloaded JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# CI alternative: paste the full JSON contents into this var instead (used by GitHub Actions).
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# FETCH_LIMIT=50
# BRIEF_TOP_N=10
# SHEET_WORKSHEET=briefs
